---
// Program output block. Visually separate from code, with no syntax highlighting.
// The text normally comes from verified output files via <Sample>/<Pair>/<Predict>/
// <Mistake>; don't use hand-written output.
import type { OutputBlock } from './lib/samples';

interface Props {
	text: string;
	variant?: OutputBlock['variant'];
	label?: string;
	/** What was typed on the keyboard (input.txt). */
	input?: string;
}

const defaultLabels: Record<OutputBlock['variant'], string> = {
	output: 'Output',
	warning: 'Warning',
	typecheck: 'Type checker (mypy)',
	'compile-error': 'Compile error',
	exception: 'Runtime error',
};

const { text, variant = 'output', input } = Astro.props;
const label = Astro.props.label ?? defaultLabels[variant];
const trimmedInput = input?.replace(/\s+$/, '');
---

<figure class="cs-output not-content" data-variant={variant}>
	<figcaption class="cs-output__label">{label}</figcaption>
	{
		trimmedInput && (
			<p class="cs-output__input">
				<span class="cs-output__input-label">Typed input:</span>
				<code>{trimmedInput}</code>
			</p>
		)
	}
	<pre class="cs-output__text" tabindex="0"><code>{text === '' ? '(no output)' : text}</code></pre>
</figure>
