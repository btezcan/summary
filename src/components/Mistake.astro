---
// Common mistake: "Wrong / Right" comparison in one language. Both sides are
// verified samples; the wrong side's compile error, exception or wrong output is
// shown exactly as it was produced.
// Usage:
//   <Mistake lang="cs" wrong="types/unassigned" right="types/unassigned-fixed">
//     A local variable must have a value before it is used.
//   </Mistake>
import LangCode from './LangCode.astro';
import { LANGS, type Lang } from './lib/samples';

interface Props {
	lang: Lang;
	wrong: string;
	right: string;
	wrongRegion?: string;
	rightRegion?: string;
	/** Short title, e.g. "Unassigned variable". */
	title?: string;
}

const { lang, wrong, right, wrongRegion, rightRegion, title } = Astro.props;
const langName = LANGS[lang].name;
const sides = [
	{ kind: 'wrong', label: 'Wrong', id: wrong, region: wrongRegion },
	{ kind: 'right', label: 'Right', id: right, region: rightRegion },
];
---

<section class="cs-mistake" aria-label={`Common mistake (${langName})${title ? ': ' + title : ''}`}>
	<p class="cs-mistake__title">
		<span class="cs-mistake__lang">{langName}</span>
		{title && <span>{title}</span>}
	</p>
	<div class="cs-mistake__grid">
		{
			sides.map((s) => (
				<div class="cs-mistake__side" data-kind={s.kind}>
					<p class="cs-mistake__label">
						<span class="cs-mistake__icon" aria-hidden="true">
							{s.kind === 'wrong' ? '✗' : '✓'}
						</span>
						{s.label}
					</p>
					<LangCode id={s.id} lang={lang} region={s.region} title={LANGS[lang].name} />
				</div>
			))
		}
	</div>
	{Astro.slots.has('default') && <div class="cs-mistake__explain"><slot /></div>}
</section>
