---
// Callout box.
//   tip      Tip
//   warning  Warning
//   version  Version note (e.g. version="C# 13" or version="Python 3.13")
//   history  "Old code you may see" — outdated things students will still meet
interface Props {
	type?: 'tip' | 'warning' | 'version' | 'history';
	title?: string;
	version?: string;
}

const { type = 'tip', version } = Astro.props;

const defaultTitles = {
	tip: 'Tip',
	warning: 'Warning',
	version: version ? `Version note: ${version}` : 'Version note',
	history: 'Old code you may see',
};
const title = Astro.props.title ?? defaultTitles[type];
---

<aside class="cs-note" data-type={type} aria-label={title}>
	<p class="cs-note__title">{title}</p>
	<div class="cs-note__body"><slot /></div>
</aside>
