---
// "Predict the output" exercise. The answer is inside <details>, so it works
// without JavaScript. The slot is the explanation.
//
// One language:   <Predict id="operators/modulo" lang="py">…</Predict>
// Both languages: <Predict id="operators/modulo">…</Predict>
//   (C# and Python side by side; the answer reveals both outputs — ideal for
//    cases where the two languages disagree)
import { Code } from '@astrojs/starlight/components';
import Outputs from './Outputs.astro';
import { codeTitle, getCode, getSample, LANGS, type Lang } from './lib/samples';

interface Props {
	id: string;
	/** Omit to show both languages. */
	lang?: Lang;
	file?: string;
	region?: string;
	/** Question text (default: "What does this program print?"). */
	question?: string;
}

const { id, lang, file, region } = Astro.props;
const langs: Lang[] = lang ? [lang] : ['cs', 'py'];
const both = langs.length === 2;
const question = Astro.props.question ?? (both ? 'What does each program print?' : 'What does this program print?');
const sides = langs.map((l) => ({
	lang: l,
	sample: getSample(id, l),
	code: getCode(id, l, file, region),
}));
---

<section class="cs-predict" aria-label="Predict the output">
	<p class="cs-predict__question">{question}</p>
	<div class="cs-predict__row">
		{
			sides.map((s) => (
				<div class="cs-predict__side" data-lang={s.lang}>
					<Code code={s.code} lang={LANGS[s.lang].codeLang} title={both ? codeTitle(s.lang, file) : undefined} />
				</div>
			))
		}
	</div>
	<details class="cs-predict__answer">
		<summary>Show answer</summary>
		<div class="cs-predict__content">
			<div class="cs-predict__row">
				{
					sides.map((s) => (
						<div class="cs-predict__side" data-lang={s.lang}>
							{both && <p class="cs-predict__lang">{LANGS[s.lang].name}</p>}
							<Outputs sample={s.sample} partialCode={Boolean(region)} />
						</div>
					))
				}
			</div>
			{Astro.slots.has('default') && <div class="cs-predict__explain"><slot /></div>}
		</div>
	</details>
</section>
