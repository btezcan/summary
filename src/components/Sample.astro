---
// One verified sample in one language: code + real output.
// Usage: <Sample id="types/overflow" lang="cs" />
//        <Sample id="types/overflow" lang="py" region="big" />
//        <Sample id="classes/bank" lang="cs" file="BankAccount.cs" output={false} />
// To show C# and Python together, use <Pair> instead.
import LangCode from './LangCode.astro';
import type { Lang } from './lib/samples';

interface Props {
	/** Folder under samples/, e.g. "types/overflow" */
	id: string;
	lang: Lang;
	/** File to show (default Program.cs / main.py). */
	file?: string;
	/** Show only the "region name" … "endregion" part. */
	region?: string;
	/** Code frame title (default: "C# · Program.cs"). */
	title?: string;
	/** Show the output (default: true). */
	output?: boolean;
	/** Lines to highlight, e.g. "3" or "{2-4}". */
	mark?: string;
}

const props = Astro.props;
---

<div class="cs-sample" data-lang={props.lang}>
	<LangCode {...props} />
</div>
