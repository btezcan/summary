---
// Concept comparison, in two forms:
//
// 1) Table — cells may use `code` and **bold**:
//   <Compare
//     caption="C# vs Python integer types"
//     headers={['', 'C#', 'Python']}
//     rows={[['Size', 'fixed (4 bytes for int)', 'grows as needed'], ...]}
//   />
//
// 2) Code side by side — each item is a verified sample (any language):
//   <Compare items={[
//     { title: 'record', id: 'rse/record', lang: 'cs' },
//     { title: 'dataclass', id: 'rse/dataclass', lang: 'py' },
//   ]} />
// For the standard C# | Python pair of one sample id, use <Pair> instead.
import LangCode from './LangCode.astro';
import { inline } from './lib/inline';
import type { Lang } from './lib/samples';

interface Item {
	title: string;
	id: string;
	lang: Lang;
	file?: string;
	region?: string;
}

interface Props {
	caption?: string;
	headers?: string[];
	rows?: string[][];
	items?: Item[];
	/** Show outputs for code items (default: true). */
	output?: boolean;
}

const { caption, headers, rows, items, output = true } = Astro.props;
if (!rows && !items) throw new Error('<Compare> needs "rows" or "items".');
if (rows && headers && rows.some((r) => r.length !== headers.length)) {
	throw new Error(`<Compare>: every row needs ${headers.length} cells.`);
}
---

{
	rows && (
		<div class="cs-compare cs-compare--table" tabindex="0" role="region" aria-label={caption ?? 'Comparison table'}>
			<table>
				{caption && <caption>{caption}</caption>}
				{headers && (
					<thead>
						<tr>
							{headers.map((h) => (
								<th scope="col" set:html={inline(h)} />
							))}
						</tr>
					</thead>
				)}
				<tbody>
					{rows.map((row) => (
						<tr>
							{row.map((cell, i) =>
								i === 0 ? (
									<th scope="row" set:html={inline(cell)} />
								) : (
									<td data-label={headers?.[i] || undefined} set:html={inline(cell)} />
								),
							)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	)
}
{
	items && (
		<figure class="cs-compare cs-compare--code">
			{caption && <figcaption class="cs-compare__caption">{caption}</figcaption>}
			<div class="cs-compare__grid" style={`--cs-compare-cols: ${items.length}`}>
				{items.map((it) => (
					<div class="cs-compare__item">
						<p class="cs-compare__title" set:html={inline(it.title)} />
						<LangCode id={it.id} lang={it.lang} file={it.file} region={it.region} output={output} />
					</div>
				))}
			</div>
		</figure>
	)
}
