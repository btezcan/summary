<Project>
  <!--
    Shared settings for every C# sample (file-based apps and projects).
    The site teaches up to C# 12: a newer feature fails to compile. A sample
    that uses one on purpose sets "langVersion" in its sample.json, and the page
    marks it with <Note type="version">.
  -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- File-based apps (dotnet run file.cs) default to native AOT, which adds
         trimming/AOT warnings (IL2026, IL3050) that a normal console project
         never shows. Samples should behave like a normal project. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
